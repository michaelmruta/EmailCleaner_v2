YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
PORT=3333

# Concurrent LLM classification calls / mbox downloads per batch
PARALLEL_WORKERS=5

# ── AI classification (used for emails the rule engine can't confidently sort) ──
# Which provider to use: ollama | openai | anthropic | openrouter
AI_PROVIDER=ollama

# Ollama (local, free — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# OpenAI — https://platform.openai.com/api-keys (requires billing on your account)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — https://console.anthropic.com/settings/keys (requires billing on your account)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenRouter — https://openrouter.ai/keys (requires billing/credits on your account)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
